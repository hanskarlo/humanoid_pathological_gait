    def "SimMaterials"
    {
        def Material "frictionless" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0
            float physics:restitution = 0
            float physics:staticFriction = 0
            custom token physxMaterial:frictionCombineMode = "multiply"
            custom token physxMaterial:restitutionCombineMode = "multiply"
        }
    }
}

