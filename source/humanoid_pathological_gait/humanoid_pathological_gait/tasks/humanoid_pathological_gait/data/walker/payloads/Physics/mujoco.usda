    over "Physics"
    {
        def MjcActuator "fr_steering_joint_actuator"
        {
            uniform double mjc:forceRange:max = 5
            uniform double mjc:forceRange:min = -5
            custom rel mjc:target
            prepend rel mjc:target = </smart_walker/Physics/fr_steering_joint>
        }

        def MjcActuator "fr_wheel_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </smart_walker/Physics/fr_wheel>
        }

        def MjcActuator "fl_steering_joint_actuator"
        {
            uniform double mjc:forceRange:max = 5
